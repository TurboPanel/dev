#!/bin/sh
# Start the TurboPanel developer console (Node + Vite).
#
# 1. Load shared helpers (paths, sudo, apt packages, runtime installers)
# 2. Ensure pinned Node (runs this repo) is installed
# 3. Install JS dependencies with pnpm and launch the Ink TUI via vite-node
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
TUI_ENTRY=src/tui.tsx
CONSOLE_WATCH=

# Shared shell libraries (see scripts/lib/)
. "$SCRIPT_DIR/scripts/lib/privileges.sh"  # tp_info, tp_error, sudo helpers
. "$SCRIPT_DIR/scripts/lib/paths.sh"       # NODE_BIN, /opt/turbopanel paths
. "$SCRIPT_DIR/scripts/lib/packages.sh"    # apt install curl/tar/xz if needed
. "$SCRIPT_DIR/scripts/lib/runtime.sh"      # tp_ensure_node_runtime
. "$SCRIPT_DIR/scripts/lib/dev-identity.sh" # tp_resolve_dev_identity
. "$SCRIPT_DIR/scripts/lib/dev-prerequisites.sh"  # tp_ensure_dev_prerequisites

for _tp_arg in "$@"; do
  case $_tp_arg in
    --watch|-w)
      CONSOLE_WATCH=1
      ;;
    -h|--help)
      cat <<EOF
Usage: ./console [--watch]

  --watch, -w   Hot-reload the TUI (Vite Fast Refresh) when source files change
EOF
      exit 0
      ;;
    *)
      tp_error "Unknown option: $_tp_arg"
      echo "Run ./console --help for usage." >&2
      exit 1
      ;;
  esac
done

if [ -n "${TURBOPANEL_CONSOLE_WATCH:-}" ]; then
  CONSOLE_WATCH=1
fi

# curl | sh leaves stdin on a pipe; attach stdio to the controlling terminal when available.
if [ ! -t 0 ] || [ ! -t 1 ] || [ ! -t 2 ]; then
  if tp_is_interactive; then
    exec </dev/tty >/dev/tty 2>/dev/tty
  else
    tp_error "The developer console needs an interactive terminal."
    echo "Run ./console directly in a terminal — not through a pipe or redirect." >&2
    exit 1
  fi
fi

tp_ensure_dev_prerequisites

tp_info "Checking Node runtime…"
tp_ensure_node_runtime
tp_export_node_path
tp_ensure_corepack_pnpm "$SCRIPT_DIR"

PNPM_BIN=${PNPM_BIN:-$NODE_PREFIX/bin/pnpm}

cd "$SCRIPT_DIR"

tp_info "Installing JS dependencies…"
if [ -f pnpm-lock.yaml ]; then
  COREPACK_ENABLE_DOWNLOAD_PROMPT=0 "$PNPM_BIN" install --frozen-lockfile \
    || COREPACK_ENABLE_DOWNLOAD_PROMPT=0 "$PNPM_BIN" install
else
  COREPACK_ENABLE_DOWNLOAD_PROMPT=0 "$PNPM_BIN" install
fi

if [ -n "$CONSOLE_WATCH" ]; then
  tp_info "Launching console UI (Fast Refresh — edits hot-reload)…"
  tp_export_dev_repo_contract
  exec env COREPACK_ENABLE_DOWNLOAD_PROMPT=0 "$PNPM_BIN" exec vite-node scripts/hot-reload.tsx
fi

tp_info "Launching console UI…"
tp_export_dev_repo_contract
exec env COREPACK_ENABLE_DOWNLOAD_PROMPT=0 "$PNPM_BIN" exec vite-node "$TUI_ENTRY"

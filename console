#!/bin/sh
# Start the TurboPanel developer console.
#
# 1. Load shared helpers (paths, sudo, apt packages, Deno install)
# 2. Install or upgrade Deno under /opt/turbopanel/runtimes when the pinned version changes
# 3. Cache JS dependencies and launch src/main.tsx
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)

# Shared shell libraries (see scripts/lib/)
. "$SCRIPT_DIR/scripts/lib/privileges.sh"  # tp_info, tp_error, sudo helpers
. "$SCRIPT_DIR/scripts/lib/paths.sh"       # DENO_BIN, /opt/turbopanel paths
. "$SCRIPT_DIR/scripts/lib/packages.sh"    # apt install curl/unzip if needed
. "$SCRIPT_DIR/scripts/lib/runtime.sh"      # tp_ensure_deno_runtime
. "$SCRIPT_DIR/scripts/lib/dev-host-access.sh"  # tp_ensure_dev_host_access

if [ ! -t 0 ] || [ ! -t 1 ]; then
  tp_error "The developer console needs an interactive terminal."
  echo "Run ./console directly in a terminal — not through a pipe or redirect." >&2
  exit 1
fi

tp_info "Checking Deno runtime…"
tp_ensure_deno_runtime

tp_info "Setting up dev host access (group, sudoers, ACLs)…"
# #region agent log
_tp_dha_start=$(date +%s)
_tp_debug_log "H4" "dev_host_access_start" "{}"
# #endregion
tp_ensure_dev_host_access
# #region agent log
_tp_dha_end=$(date +%s)
_tp_debug_log "H4" "dev_host_access_done" "{\"duration_s\":$((_tp_dha_end - _tp_dha_start))}"
# #endregion

if "$DENO_BIN" cache --frozen "$SCRIPT_DIR/src/main.tsx" 2>/dev/null; then
  tp_info "Dependencies ready"
else
  tp_info "Caching JS dependencies (first run may take a minute)…"
  "$DENO_BIN" cache "$SCRIPT_DIR/src/main.tsx"
fi

tp_info "Launching console UI…"

cd "$SCRIPT_DIR"
exec "$DENO_BIN" run --allow-all src/main.tsx

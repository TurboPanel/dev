# TurboPanel Tilt dev reverse proxy (Docker → host wrangler + Expo).
#
#   /api/*  and  /ws/*  -> host wrangler (INSTANCE_DEV_PORT, default 18787)
#   everything else      -> host Expo web when TURBOPANEL_UI_MODE=dev
#
# Env (from docker/.env via compose):
#   UPSTREAM_HOST            host.docker.internal in Docker
#   INSTANCE_DEV_PORT / EXPO_PORT / TURBOPANEL_UI_MODE / CADDY_TLS_* / TURBOPANEL_UI_ROOT
{
	auto_https off
	admin off
	# HTTP/3/QUIC fails with the dev self-signed cert on many browsers; keep h1/h2 only.
	servers :8443 {
		protocols h1 h2
	}
}

:{$CADDY_PORT:8443} {
	tls {$CADDY_TLS_CERT:/certs/self-signed.crt} {$CADDY_TLS_KEY:/certs/self-signed.key}

	@api path /api/*
	handle @api {
		reverse_proxy {$UPSTREAM_HOST:host.docker.internal}:{$INSTANCE_DEV_PORT:18787} {
			header_up X-Real-IP {remote_host}
		}
	}

	@ws path /ws/*
	handle @ws {
		reverse_proxy {$UPSTREAM_HOST:host.docker.internal}:{$INSTANCE_DEV_PORT:18787} {
			header_up X-Real-IP {remote_host}
		}
	}

	@ui_dev expression `"{$TURBOPANEL_UI_MODE:static}" == "dev"`
	handle @ui_dev {
		reverse_proxy {$UPSTREAM_HOST:host.docker.internal}:{$EXPO_PORT:8081} {
			header_up Host {$UPSTREAM_HOST:host.docker.internal}:{$EXPO_PORT:8081}
		}
	}

	handle {
		root * {$TURBOPANEL_UI_ROOT:/ui/dist}
		try_files {path} /index.html
		file_server
	}
}

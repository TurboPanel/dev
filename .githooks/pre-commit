#!/usr/bin/env sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"

# Secret scan is never skippable.
"$ROOT/scripts/scan-secrets.sh"

if [ -n "${TURBOPANEL_SKIP_HOOK_TESTS:-}" ]; then
  echo "pre-commit: TURBOPANEL_SKIP_HOOK_TESTS set — skipping typecheck/tests" >&2
  exit 0
fi

# shellcheck source=scripts/lib/hook-toolchain.sh
. "$ROOT/scripts/lib/hook-toolchain.sh"
tp_hook_ensure_pnpm_toolchain "$ROOT"

cd "$ROOT"
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
"$PNPM_BIN" typecheck
"$PNPM_BIN" test

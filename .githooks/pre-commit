#!/usr/bin/env sh
set -eu
# Take the root from git, not from this file's path: a custom absolute
# core.hooksPath would otherwise point the hook at another checkout.
ROOT="$(git rev-parse --show-toplevel)"
if [ -z "$ROOT" ]; then
  echo "pre-commit: git rev-parse --show-toplevel found no repository root" >&2
  exit 1
fi
cd "$ROOT"

# Secret scan is never skippable.
"$ROOT/scripts/scan-secrets.sh"

# Future: re-enable typecheck/tests once the toolchain runs inside the Vagrant guest
# (host checkouts share VirtFS with the VM and often lack a usable Node/pnpm tree).
echo "pre-commit: typecheck/tests disabled — secret scan only" >&2
exit 0

#!/usr/bin/env sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"

# Secret scan is never skippable.
"$ROOT/scripts/scan-secrets.sh"

if [ -n "${TURBOPANEL_SKIP_HOOK_TESTS:-}" ]; then
  echo "pre-commit: TURBOPANEL_SKIP_HOOK_TESTS set — skipping typecheck/tests" >&2
  exit 0
fi

# Resolve pnpm the way ./console does (paths.sh only — no installs/sudo).
# shellcheck source=scripts/lib/paths.sh
. "$ROOT/scripts/lib/paths.sh"
# pnpm is a Corepack shim (`#!/usr/bin/env node`); put vendored Node on PATH
# so commits from IDE environments without host node still work.
if [ -x "${NODE_BIN:-}" ]; then
  PATH="$(dirname "$NODE_BIN"):${PATH:-}"
  export PATH
fi
PNPM_BIN=${PNPM_BIN:-$NODE_PREFIX/bin/pnpm}
if [ ! -x "$PNPM_BIN" ]; then
  PNPM_BIN=$(command -v pnpm 2>/dev/null || true)
fi

if [ -z "$PNPM_BIN" ] || [ ! -x "$PNPM_BIN" ]; then
  echo "pre-commit: pnpm not found — run ./console (skips typecheck/tests)" >&2
  exit 0
fi

if [ ! -d "$ROOT/node_modules" ]; then
  echo "pre-commit: node_modules/ missing — run ./console or pnpm install (skips typecheck/tests)" >&2
  exit 0
fi

cd "$ROOT"
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
"$PNPM_BIN" typecheck
"$PNPM_BIN" test

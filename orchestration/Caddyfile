# TurboPanel reverse proxy (co-located development only).
#
# Loaded by turbopanel-caddy.service when turbopanel_dev_user is set
# (`{{ turbopanel_dev_root }}/dev/orchestration/Caddyfile`). Production uses
# the instance checkout's Caddyfile instead — never ship this file to managed
# hosts.
#
#   /api/*, /ws/*, /webhook/*  -> Deno socket or wrangler dev
#   UI                          -> Expo (:8081) when UI_MODE=dev, else static export
#   :8880                       -> plaintext mirror of :8443 (always on in this file)
#
# Each listener ends in a catch-all that serves the UI, so ANY prefix the
# instance owns must be matched before it. A missed prefix does not 404 — it
# serves the SPA shell with HTTP 200, and a Git provider reads that as a
# delivered webhook and never retries.
#
# Env:
#   TURBOPANEL_UI_MODE           "dev" | "static" (default: static)
#   EXPO_PORT                    Expo dev server port when UI_MODE=dev (default: 8081)
#   TURBOPANEL_UI_ROOT           Static export directory when UI_MODE=static
#   TURBOPANEL_DAEMON_REPO       Daemon checkout root; /downloads/daemon + installer at /run.sh
#   TURBOPANEL_SOCKET_DIAL       Unix socket dial path for Deno instance
#   TURBOPANEL_INSTANCE_RUNTIME  "deno" | "workers" (default: deno)
#   WRANGLER_DEV_PORT            wrangler dev port when runtime is workers
#   CADDY_PORT                   HTTPS listen port (default: 8443)
#   CADDY_HTTP_PORT              Plaintext HTTP listen port (default: 8880)
#   CADDY_TLS_CERT / CADDY_TLS_KEY
{
	auto_https off
	# Localhost-only admin so `systemctl reload` / `caddy reload` can swap leaf
	# certs without killing the process. Public-urls apply runs through this
	# reverse proxy (incl. Cloudflare → origin); a full restart mid-request
	# surfaces as HTTP 502 at the edge.
	admin localhost:2019
}

# Shared site body — included conceptually by both :8443 and :8880 listeners.
# (Caddy has no import macros here; keep the two blocks in sync.)

:{$CADDY_PORT:8443} {
	tls {$CADDY_TLS_CERT:./certs/self-signed.crt} {$CADDY_TLS_KEY:./certs/self-signed.key}

	# Forwarding headers are believable only from a connector on this host — a
	# `cloudflared` tunnel beside Caddy, or another local proxy. Strip any
	# client-supplied copy so a daemon dialling this proxy over the network
	# cannot declare its own address; the instance reads CF-Connecting-IP /
	# X-Forwarded-For only when its immediate peer is loopback
	# (TURBOPANEL_TRUSTED_PROXY_CIDRS widens that set).
	#
	# Development caveat: Vagrant forwards these ports over SSH, so a daemon on
	# the LAN arrives as 127.0.0.1 and this matcher does not fire for it. That
	# is also why the instance falls back to the daemon's own reported
	# interface addresses instead of showing every server as 127.0.0.1.
	@remote_peer not remote_ip 127.0.0.0/8 ::1
	request_header @remote_peer -CF-Connecting-IP
	request_header @remote_peer -True-Client-IP
	request_header @remote_peer -X-Forwarded-For

	@api path /api/*
	handle @api {
		@workers_runtime expression `"{$TURBOPANEL_INSTANCE_RUNTIME:deno}" == "workers"`
		handle @workers_runtime {
			reverse_proxy 127.0.0.1:{$WRANGLER_DEV_PORT:18787} {
				header_up X-Real-IP {remote_host}
			}
		}
		handle {
			reverse_proxy unix//{$TURBOPANEL_SOCKET_DIAL:run/turbopanel/instance.sock} {
				header_up X-Real-IP {remote_host}
			}
		}
	}

	@ws path /ws/*
	handle @ws {
		@workers_runtime expression `"{$TURBOPANEL_INSTANCE_RUNTIME:deno}" == "workers"`
		handle @workers_runtime {
			reverse_proxy 127.0.0.1:{$WRANGLER_DEV_PORT:18787} {
				header_up X-Real-IP {remote_host}
			}
		}
		handle {
			reverse_proxy unix//{$TURBOPANEL_SOCKET_DIAL:run/turbopanel/instance.sock} {
				header_up X-Real-IP {remote_host}
			}
		}
	}

	# Inbound Git provider webhooks. Its own top-level prefix because the caller
	# is GitHub or GitLab — no session, no daemon JWT, no Origin. X-Real-IP is
	# load-bearing: the webhook rate limiter keys per peer address.
	@webhook path /webhook/*
	handle @webhook {
		@workers_runtime expression `"{$TURBOPANEL_INSTANCE_RUNTIME:deno}" == "workers"`
		handle @workers_runtime {
			reverse_proxy 127.0.0.1:{$WRANGLER_DEV_PORT:18787} {
				header_up X-Real-IP {remote_host}
			}
		}
		handle {
			reverse_proxy unix//{$TURBOPANEL_SOCKET_DIAL:run/turbopanel/instance.sock} {
				header_up X-Real-IP {remote_host}
			}
		}
	}

	# Expo is often still binding when Caddy starts — show a spinner instead of a bare 502.
	handle_errors 502 503 {
		@expoUpstream vars expoUpstream true
		handle @expoUpstream {
			root * {$TURBOPANEL_DEV_ORCHESTRATION_DIR:.}
			rewrite * /expo-loading.html
			file_server {
				status 200
			}
		}
	}

	# Always serve overlay artifacts so remote servers (LAN or Cloudflare tunnel)
	# never hit the public CDN. Catalog lives at /downloads/daemon/channels.json.
	@dev_daemon_downloads path /downloads/daemon/*
	handle @dev_daemon_downloads {
		header Cache-Control "no-store"
		route {
			root * {$TURBOPANEL_DAEMON_REPO:../turbopaneld}/dist
			uri strip_prefix /downloads/daemon
			file_server {
				browse
			}
		}
	}

	@dev_daemon_install path /run.sh
	handle @dev_daemon_install {
		header Cache-Control "no-store"
		header Content-Type "text/x-shellscript; charset=utf-8"
		root * {$TURBOPANEL_DAEMON_REPO:../turbopaneld}
		rewrite * /scripts/run.sh
		file_server
	}

	@ui_dev expression `"{$TURBOPANEL_UI_MODE:static}" == "dev"`
	handle @ui_dev {
		route {
			vars expoUpstream true
			reverse_proxy 127.0.0.1:{$EXPO_PORT:8081} {
				# Forward host:port (not hostname alone). Expo CorsMiddleware compares
				# Origin's URL.host (includes :8880/:8443) to req.headers.host —
				# {http.request.host} strips the port so LAN origins fail.
				header_up Host {http.request.hostport}
				header_up X-Forwarded-Proto {http.request.scheme}
				# Unbuffered flush so Expo Fast Refresh (/hot WebSocket) is not held.
				flush_interval -1
			}
		}
	}

	handle {
		root * {$TURBOPANEL_UI_ROOT:/opt/turbopanel/share/ui}
		try_files {path} /index.html
		file_server
	}
}

# Plaintext HTTP mirror of :8443 (no TLS). Always on in development — this
# Caddyfile is only loaded on co-located hosts.
:{$CADDY_HTTP_PORT:8880} {
	# Forwarding headers are believable only from a connector on this host — a
	# `cloudflared` tunnel beside Caddy, or another local proxy. Strip any
	# client-supplied copy so a daemon dialling this proxy over the network
	# cannot declare its own address; the instance reads CF-Connecting-IP /
	# X-Forwarded-For only when its immediate peer is loopback
	# (TURBOPANEL_TRUSTED_PROXY_CIDRS widens that set).
	#
	# Development caveat: Vagrant forwards these ports over SSH, so a daemon on
	# the LAN arrives as 127.0.0.1 and this matcher does not fire for it. That
	# is also why the instance falls back to the daemon's own reported
	# interface addresses instead of showing every server as 127.0.0.1.
	@remote_peer not remote_ip 127.0.0.0/8 ::1
	request_header @remote_peer -CF-Connecting-IP
	request_header @remote_peer -True-Client-IP
	request_header @remote_peer -X-Forwarded-For

	handle_errors 502 503 {
		@expoUpstream vars expoUpstream true
		handle @expoUpstream {
			root * {$TURBOPANEL_DEV_ORCHESTRATION_DIR:.}
			rewrite * /expo-loading.html
			file_server {
				status 200
			}
		}
	}

	@api path /api/*
	handle @api {
		@workers_runtime expression `"{$TURBOPANEL_INSTANCE_RUNTIME:deno}" == "workers"`
		handle @workers_runtime {
			reverse_proxy 127.0.0.1:{$WRANGLER_DEV_PORT:18787} {
				header_up X-Real-IP {remote_host}
			}
		}
		handle {
			reverse_proxy unix//{$TURBOPANEL_SOCKET_DIAL:run/turbopanel/instance.sock} {
				header_up X-Real-IP {remote_host}
			}
		}
	}

	@ws path /ws/*
	handle @ws {
		@workers_runtime expression `"{$TURBOPANEL_INSTANCE_RUNTIME:deno}" == "workers"`
		handle @workers_runtime {
			reverse_proxy 127.0.0.1:{$WRANGLER_DEV_PORT:18787} {
				header_up X-Real-IP {remote_host}
			}
		}
		handle {
			reverse_proxy unix//{$TURBOPANEL_SOCKET_DIAL:run/turbopanel/instance.sock} {
				header_up X-Real-IP {remote_host}
			}
		}
	}

	# Inbound Git provider webhooks. Its own top-level prefix because the caller
	# is GitHub or GitLab — no session, no daemon JWT, no Origin. X-Real-IP is
	# load-bearing: the webhook rate limiter keys per peer address.
	@webhook path /webhook/*
	handle @webhook {
		@workers_runtime expression `"{$TURBOPANEL_INSTANCE_RUNTIME:deno}" == "workers"`
		handle @workers_runtime {
			reverse_proxy 127.0.0.1:{$WRANGLER_DEV_PORT:18787} {
				header_up X-Real-IP {remote_host}
			}
		}
		handle {
			reverse_proxy unix//{$TURBOPANEL_SOCKET_DIAL:run/turbopanel/instance.sock} {
				header_up X-Real-IP {remote_host}
			}
		}
	}

	# Overlay artifacts (LAN or tunnel). Catalog: /downloads/daemon/channels.json
	@dev_daemon_downloads path /downloads/daemon/*
	handle @dev_daemon_downloads {
		header Cache-Control "no-store"
		route {
			root * {$TURBOPANEL_DAEMON_REPO:../turbopaneld}/dist
			uri strip_prefix /downloads/daemon
			file_server {
				browse
			}
		}
	}

	@dev_daemon_install path /run.sh
	handle @dev_daemon_install {
		header Cache-Control "no-store"
		header Content-Type "text/x-shellscript; charset=utf-8"
		root * {$TURBOPANEL_DAEMON_REPO:../turbopaneld}
		rewrite * /scripts/run.sh
		file_server
	}

	@ui_dev expression `"{$TURBOPANEL_UI_MODE:static}" == "dev"`
	handle @ui_dev {
		route {
			vars expoUpstream true
			reverse_proxy 127.0.0.1:{$EXPO_PORT:8081} {
				header_up Host {http.request.hostport}
				header_up X-Forwarded-Proto {http.request.scheme}
				flush_interval -1
			}
		}
	}

	handle {
		root * {$TURBOPANEL_UI_ROOT:/opt/turbopanel/share/ui}
		try_files {path} /index.html
		file_server
	}
}

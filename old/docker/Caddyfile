# TurboPanel Tilt dev reverse proxy (Docker → host wrangler or Deno Unix socket + Expo).
#
#   /api/*  and  /ws/*  -> wrangler TCP (workers) or Deno Unix socket (deno)
#   everything else      -> host Expo web when TURBOPANEL_UI_MODE=dev
#
# Env (from docker/.env via compose):
#   UPSTREAM_HOST / INSTANCE_DEV_PORT / TURBOPANEL_INSTANCE_RUNTIME / TURBOPANEL_SOCKET_DIAL
#   EXPO_PORT / TURBOPANEL_UI_MODE / CADDY_TLS_* / TURBOPANEL_UI_ROOT
{
	auto_https off
	admin off
	# HTTP/3/QUIC fails with the dev self-signed cert on many browsers; keep h1/h2 only.
	servers :8443 {
		protocols h1 h2
	}
}

:{$CADDY_PORT:8443} {
	tls {$CADDY_TLS_CERT:/certs/self-signed.crt} {$CADDY_TLS_KEY:/certs/self-signed.key}

	@api path /api/*
	handle @api {
		@workers_mode expression `"{$TURBOPANEL_INSTANCE_RUNTIME:workers}" == "workers"`
		handle @workers_mode {
			reverse_proxy {$UPSTREAM_HOST:host.docker.internal}:{$INSTANCE_DEV_PORT:18787} {
				header_up X-Real-IP {remote_host}
			}
		}
		handle {
			reverse_proxy unix//{$TURBOPANEL_SOCKET_DIAL:run/turbopanel-dev/instance.sock} {
				header_up X-Real-IP {remote_host}
			}
		}
	}

	@ws path /ws/*
	handle @ws {
		@workers_mode expression `"{$TURBOPANEL_INSTANCE_RUNTIME:workers}" == "workers"`
		handle @workers_mode {
			reverse_proxy {$UPSTREAM_HOST:host.docker.internal}:{$INSTANCE_DEV_PORT:18787} {
				header_up X-Real-IP {remote_host}
			}
		}
		handle {
			reverse_proxy unix//{$TURBOPANEL_SOCKET_DIAL:run/turbopanel-dev/instance.sock} {
				header_up X-Real-IP {remote_host}
			}
		}
	}

	@ui_dev expression `"{$TURBOPANEL_UI_MODE:static}" == "dev"`
	handle @ui_dev {
		route {
			vars expoUpstream true
			reverse_proxy {$UPSTREAM_HOST:host.docker.internal}:{$EXPO_PORT:8081} {
				header_up Host {$UPSTREAM_HOST:host.docker.internal}:{$EXPO_PORT:8081}
			}
		}
	}

	# Expo is often still binding when Caddy starts — show a spinner instead of a bare 502.
	handle_errors 502 503 {
		@expoUpstream vars expoUpstream true
		handle @expoUpstream {
			root * /caddy-static
			rewrite * /expo-loading.html
			file_server {
				status 200
			}
		}
	}

	handle {
		root * {$TURBOPANEL_UI_ROOT:/ui/dist}
		try_files {path} /index.html
		file_server
	}
}

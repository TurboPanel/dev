# TurboPanel local dev — copy to `.env` and adjust as needed.
# Tilt loads this file and `scripts/sync-env.sh` distributes values to sibling repos.
#
# Runtime: Cloudflare Workers via `pnpm dev` (wrangler) in instance/ — default.
# Set TURBOPANEL_INSTANCE_RUNTIME=deno for the self-hosted Deno path (requires Deno).
TURBOPANEL_INSTANCE_RUNTIME=workers
# In Deno mode, scripts/instance-serve.sh automatically exports
# TURBOPANEL_DEV_HOST_AUTH=group-only — no manual action needed. This bypasses PAM
# password verification while still checking sudo/admin group membership.

# --- Instance (Wrangler / Workers + Deno) ---
# TURBOPANEL_SECRET=  (auto-generated by scripts/init-env.mjs when unset; 48 chars [A-Za-z0-9_])
# Versioned rotation list — highest version first (current signing key):
# TURBOPANEL_SECRETS=2:new-secret,1:old-secret
INSTANCE_DEV_PORT=18787
# Enable public sign-up in local Workers dev (synced to instance/.dev.vars).
TURBOPANEL_IS_SIGNUP_ENABLED=1

# --- Postgres (Tilt Docker container — default for local Workers dev) ---
POSTGRES_USER=turbopanel
POSTGRES_PASSWORD=turbopanel-dev
POSTGRES_DB=turbopanel
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional overrides (sync-env.sh derives both from POSTGRES_* when unset):
# TURBOPANEL_DATABASE_URL=postgresql://user:pass@host:5432/db
#   Migrations, Drizzle, sync.sh — separate from Hyperdrive runtime credentials in production.
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://user:pass@host:5432/db
#   wrangler dev local Hyperdrive binding (binding name HYPERDRIVE → written to instance/.env).

# --- Caddy (HTTPS entrypoint — proxies to wrangler + Expo) ---
CADDY_PORT=8443
TURBOPANEL_UI_MODE=dev
EXPO_PORT=8081
WEBSITE_PORT=19820
# Optional: comma-separated browser origins allowed to call the API cross-origin (Scalar docs).
# sync-env.sh defaults to http://localhost:{WEBSITE_PORT} and http://127.0.0.1:{WEBSITE_PORT}.
# TURBOPANEL_CORS_ORIGINS=http://localhost:19820,http://127.0.0.1:19820
# Optional comma-separated DNS names for the dev TLS cert (e.g. turbopanel.lan)
TURBOPANEL_TLS_EXTRA_SANS=

# --- Mailpit (dev email) ---
MAILPIT_SMTP_PORT=19825
MAILPIT_WEB_PORT=19826

# --- RabbitMQ (Deno dev email queue) ---
RABBITMQ_AMQP_PORT=19828
RABBITMQ_MGMT_PORT=19833
# Optional override — sync-env.sh derives amqp://guest:guest@localhost:{RABBITMQ_AMQP_PORT} when unset.
# TURBOPANEL_AMQP_URL=amqp://guest:guest@localhost:19828

# --- Email ---
TURBOPANEL_SYSTEM_EMAIL_FROM=noreply@turbopanel.local
# Optional: override the public base URL used in verification links (Deno mode).
# Defaults to the request origin when unset.
# TURBOPANEL_BASE_URL=https://localhost:8443
# Workers mode (Mailgun — leave blank in Deno dev):
# TURBOPANEL_MAILGUN_API_KEY=
# TURBOPANEL_MAILGUN_DOMAIN=

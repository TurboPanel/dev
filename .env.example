# TurboPanel local dev — copy to `.env` and adjust as needed.
# Tilt loads this file and `scripts/sync-env.sh` distributes values to sibling repos.
#
# Runtime: Cloudflare Workers via `pnpm dev` (wrangler) in instance/ — not Deno.

# --- Instance (Wrangler / Workers) ---
# Session signing secrets must be base64-encoded (generate: openssl rand -base64 32).
# Single key (legacy fallback when SESSION_SECRETS is also set):
SESSION_SECRET=ZGV2LWxvY2FsLXR1cmJvcGFuZWwtc2VjcmV0LWtleQ==
# Versioned rotation list — highest version first (current signing key):
# SESSION_SECRETS=2:new-secret-base64,1:old-secret-base64
INSTANCE_DEV_PORT=18787

# --- Postgres (Tilt Docker container — default for local Workers dev) ---
POSTGRES_USER=turbopanel
POSTGRES_PASSWORD=turbopanel-dev
POSTGRES_DB=turbopanel
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional overrides (sync-env.sh derives both from POSTGRES_* when unset):
# TURBOPANEL_DATABASE_URL=postgresql://user:pass@host:5432/db
#   Migrations, Drizzle, sync.sh — separate from Hyperdrive runtime credentials in production.
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://user:pass@host:5432/db
#   wrangler dev local Hyperdrive binding (binding name HYPERDRIVE → written to instance/.env).

# --- Caddy (HTTPS entrypoint — proxies to wrangler + Expo) ---
CADDY_PORT=8443
TURBOPANEL_UI_MODE=dev
EXPO_PORT=8081
WEBSITE_PORT=19820
# Optional comma-separated DNS names for the dev TLS cert (e.g. turbopanel.lan)
TURBOPANEL_TLS_EXTRA_SANS=

    "ink-gradient": "^4.0.1",
    "ink-scroll-list": "^0.4.1",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.0"

{
  "name": "@turbopanel/dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "TurboPanel development console — an Ink TUI run on Node via Vite (vite-node) with Fast Refresh.",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "scripts": {
    "dev": "vite-node src/tui.tsx",
    "dev:watch": "vite-node scripts/hot-reload.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:git-hooks": "sh scripts/check-git-hooks-path.sh",
    "notices:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-notices.mjs",
    "notices:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-notices.mjs --check"
  },
  "dependencies": {
    "figlet": "^1.11.0",
    "ink": "^7.0.2",
    "ink-gradient": "^4.0.1",
    "ink-scroll-list": "^0.4.1",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.0"
  }
}

{
  "name": "@turbopanel/dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "TurboPanel development console — an Ink TUI run on Node via Vite (vite-node) with Fast Refresh.",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "scripts": {
    "dev": "vite-node src/tui.tsx",
    "dev:watch": "vite-node scripts/hot-reload.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:git-hooks": "sh scripts/check-git-hooks-path.sh"
  },
  "dependencies": {
    "figlet": "^1.11.0",
    "ink": "^7.0.2",
    "ink-gradient": "^4.0.1",
    "ink-scroll-list": "^0.4.1",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.0"
  }
}

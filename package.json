{
  "name": "@turbopanel/dev",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "TurboPanel development console — an Ink TUI run on Node via Vite (vite-node) with Fast Refresh.",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "scripts": {
    "dev": "vite-node src/tui.tsx",
    "dev:watch": "vite-node scripts/hot-reload.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:vocabulary": "node scripts/check-vocabulary.mjs",
    "verify:ci": "pnpm check:vocabulary && pnpm notices:check && pnpm typecheck && pnpm test:coverage",
    "typecheck": "tsc --noEmit",
    "check:git-hooks": "sh scripts/check-git-hooks-path.sh",
    "notices:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-notices.mjs",
    "notices:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-notices.mjs --check"
  },
  "dependencies": {
    "figlet": "^1.11.4",
    "ink": "^7.0.2",
    "ink-gradient": "^4.0.1",
    "ink-scroll-list": "^0.4.1",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.7.0",
    "vite": "^8.1.6",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11"
  }
}

{
  "name": "@turbopanel/dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "TurboPanel development console — an Ink TUI run on Node via Vite (vite-node) with Fast Refresh.",
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "scripts": {
    "dev": "vite-node src/tui.tsx",

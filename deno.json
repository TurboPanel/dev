{
  "name": "@turbopanel/dev",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "exports": "./src/tui.tsx",
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run --allow-all src/tui.tsx",
    "console:watch": "deno run --allow-all --watch src/tui.tsx",
    "cache": "deno cache src/tui.tsx"
  },
  "imports": {
    "ink": "npm:ink@^7.0.2",
    "@types/node": "npm:@types/node@^22",
    "react": "npm:react@^19.2.0",
    "react/jsx-runtime": "npm:react@^19.2.0/jsx-runtime"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "npm:@types/react@^19",
    "lib": ["deno.window", "dom", "dom.iterable"],
    "strict": true
  }
}

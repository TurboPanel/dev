{
  "name": "@turbopanel/dev",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "exports": "./src/main.tsx",
  "tasks": {
    "dev": "deno run --allow-all src/main.tsx",
    "console:watch": "deno run --allow-all --watch src/main.tsx",
    "cache": "deno cache src/main.tsx"
  },
  "imports": {
    "@deno-ink/core": "jsr:@deno-ink/core@^0.2.1",
    "@turbopanel/components/": "./src/components/",
    "@turbopanel/hooks/": "./src/hooks/",
    "@turbopanel/lib/": "./src/lib/",
    "@turbopanel/screens/": "./src/screens/",
    "@turbopanel/sections/": "./src/sections/",
    "react": "npm:react@18.3.1",
    "react/jsx-runtime": "npm:react@18.3.1/jsx-runtime"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "npm:@types/react@^18",
    "lib": ["deno.window", "dom", "dom.iterable"],
    "strict": true
  }
}

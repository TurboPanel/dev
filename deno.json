    "@turbopanel/compact-header": "./src/compact-header.ts",
    "@turbopanel/fetch-timeout": "./src/fetch-timeout.ts",
    "@turbopanel/use-stack-status": "./src/use-stack-status.ts",
    "@turbopanel/instance-client": "./src/instance-client.ts",
    "@turbopanel/paths": "./src/paths.ts",
    "@turbopanel/platform-install": "./src/platform-install.ts",
    "@turbopanel/ensure-dev-host-access": "./src/ensure-dev-host-access.ts",
    "@turbopanel/daemon-lifecycle": "./src/daemon-lifecycle.ts",
    "@turbopanel/instance-area": "./src/instance-area.tsx",
    "@turbopanel/instance-runtime": "./src/instance-runtime.ts",
    "@turbopanel/instance-recovery": "./src/instance-recovery.ts",
    "@turbopanel/sections/connectivity-section": "./src/sections/connectivity-section.tsx",
    "@turbopanel/sections/database-section": "./src/sections/database-section.tsx",
    "@turbopanel/sections/fleet-section": "./src/sections/fleet-section.tsx",
    "@turbopanel/developer-console": "./src/developer-console.tsx",
    "@turbopanel/sections/logs-section": "./src/sections/logs-section.tsx",
    "@turbopanel/sections/instance-section": "./src/sections/instance-section.tsx",
    "@turbopanel/sections/network-section": "./src/sections/network-section.tsx",
    "@turbopanel/sections/servers-section": "./src/sections/servers-section.tsx",
    "@turbopanel/sections/service-status-section": "./src/sections/service-status-section.tsx",
    "@turbopanel/sections/shell-section": "./src/sections/shell-section.tsx",
    "@turbopanel/reset-dev-environment": "./src/reset-dev-environment.ts",
    "@turbopanel/service-status": "./src/service-status.ts",
    "@turbopanel/stack-status": "./src/stack-status.ts",
    "@turbopanel/stack-logs": "./src/stack-logs.ts",
    "@turbopanel/status-area": "./src/status-area.tsx",
    "@turbopanel/status-line": "./src/status-line.tsx",
    "@turbopanel/workers-dev-vars": "./src/workers-dev-vars.ts",
    "@turbopanel/use-developer-state": "./src/use-developer-state.ts",
    "react": "npm:react@18.3.1",
    "react/jsx-runtime": "npm:react@18.3.1/jsx-runtime"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "npm:@types/react@^18",
    "lib": ["deno.window", "dom", "dom.iterable"],
    "strict": true
  }
}

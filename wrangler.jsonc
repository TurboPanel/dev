{
  "$schema": "node_modules/wrangler/config-schema.json",
  "send_metrics": false,
  "account_id": "a574c2793baa3e2276ac16e96097bc8c",
  "name": "turbopanel-dev",
  "main": "src/workers/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.sh"], "fallthrough": false }
  ],
  "routes": [
    {
      "pattern": "develop.trbp.nl/*",
      "zone_name": "trbp.nl"
    }
  ]
}
